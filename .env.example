# ─────────────────────────────────────────────────────────────
# TruthLens AI 3.0 — Backend Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env for local development:
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (Linux / macOS)
# ─────────────────────────────────────────────────────────────

# ─── Application Environment ──────────────────────────────────
# Options: 'development' (default) | 'production'
# When set to 'production', localhost origins are disabled from CORS.
APP_ENV=development

# ─── Server Port ──────────────────────────────────────────────
# Local default is 8000. On Render, Render injects $PORT automatically.
PORT=8000

# ─── Cross-Origin Resource Sharing (CORS) ─────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes).
# In production, set this to your deployed Render frontend static site URL.
# Example: CORS_ORIGINS=https://truthlens-frontend.onrender.com
CORS_ORIGINS=

# ─── Database Configuration ───────────────────────────────────
# Path to local SQLite database file. Default: truthlens.db
# NOTE: Render free-tier web services use ephemeral disk storage.
# Database changes will reset across service restarts/redeploys.
DATABASE_PATH=truthlens.db

# ─── AI / LLM Reasoning (Google Gemini) [Optional] ────────────
# Used by the Explainability Agent and semantic fact-checking fallbacks.
# The core PS 26188 pipeline (OCR, MRZ, Forensics, Risk Engine, Audit Trail)
# operates fully locally without requiring an API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Web Search / RAG [Optional] ──────────────────────────────
# Used by the Evidence Finder agent for open web retrieval.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ─── HuggingFace Token [Optional] ─────────────────────────────
HF_TOKEN=

# ─── Local OCR Engine [Optional] ──────────────────────────────
# TruthLens automatically uses RapidOCR (ONNX Runtime, bundled in requirements.txt).
# If you have Tesseract installed locally and prefer it, you can set the binary path here:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
