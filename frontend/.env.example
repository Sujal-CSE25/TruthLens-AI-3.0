# ─────────────────────────────────────────────────────────────
# TruthLens AI 3.0 — Frontend Environment Configuration
# ─────────────────────────────────────────────────────────────
#
# In development:
# Leave empty to use Vite's built-in development proxy (proxies /api, /analyze, etc. to http://localhost:8000)
# VITE_API_BASE_URL=
#
# In production (e.g. Render Static Site):
# Set this to the public URL of your deployed TruthLens backend Web Service (no trailing slash).
# Note: Vite injects environment variables at BUILD TIME.
# VITE_API_BASE_URL=https://<actual-backend-render-url>

VITE_API_BASE_URL=
